# Telegram / TMDB secrets
ADMIN_ID=
API_ID=
API_HASH=
BOT_TOKEN=
TMDB_API_KEY=

# Optional aliases supported by the loader
# TMDB_KEY=
# TMDB_TOKEN=

# Cinema/IPTV settings remain in config.py

# REST API / Video Player integration
API_HOST=0.0.0.0
# API_PORT can be omitted on hosts that provide PORT automatically.
API_PORT=8000
# Local development default; on a remote host set this to the public HTTPS origin.
API_BASE_URL=http://127.0.0.1:8000
# Recommended in production: public URL used in stream responses. If omitted, the API
# can infer the request origin / reverse-proxy host.
# API_PUBLIC_BASE_URL=https://my-api.example.com
API_CORS_ORIGINS=*
API_SESSION_TTL=86400
API_LOGIN_TTL=300
API_STREAM_TTL=900
API_LOG_LEVEL=info
# Optional; bot.py auto-detects it from Telegram at startup.
# BOT_USERNAME=
