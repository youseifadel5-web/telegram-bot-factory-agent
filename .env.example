# Youseif Stream Bot — environment variables / GitHub Actions secrets
# Never commit real tokens or API keys. Add values in the deployment environment.

# Telegram / administration
BOT_TOKEN=
ADMIN_ID=
ADMIN_IDS=
API_ID=
API_HASH=

# Optional Telegram local Bot API / Pyrogram
TELEGRAM_LOCAL_API=false
LOCAL_BOT_API_URL=
LOCAL_BOT_API_LOCAL_MODE=false

# AI providers and behavior
AI_ENABLED=false
AI_MODE=explicit
AI_TIMEOUT=90
AI_MAX_RETRIES=3
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
XAI_API_KEY=

# Media / catalog
TMDB_API_KEY=
FFMPEG_PATH=ffmpeg
FFMPEG_RECONNECT=true
FFMPEG_TIMEOUT=15000000
FFMPEG_RETRY=3
MAX_STREAMS=4
MAX_UPLOADS=3
MAX_PROBES=5

# Optional Cloudflare R2 storage
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
ACCOUNT_ID=
CF_API_TOKEN=

# Runtime / diagnostics
LOG_LEVEL=INFO
DATABASE_PATH=
BOT_FACTORY_ROOT=
AUTO_BUILD_ON_EVIDENCE=false
PYROGRAM_FILE_LIMIT=20971520
API_READ_ACCESS_TOKEN=
# Cloud control API (required to enable remote status/start/stop/control)
API_KEY=
API_PORT=8088

# Provider and media intelligence settings
AI_PROVIDER=openrouter
AI_MODEL=openai/gpt-4o-mini
GROK_API_KEY=
HLS_TIMEOUT=15
HLS_RETRIES=2
OSCAR_TIMEOUT=25
OSCAR_RETRIES=3
OSCAR_CACHE_TTL=300
TELEGRAM_API_URL=https://api.telegram.org

# Optional archive / channels
ARCHIVE_CHANNEL_ID=
AUTO_ARCHIVE_ON_STOP=false
ARCHIVE_MAX_DURATION_SEC=14400
ARCHIVE_MIN_DURATION_SEC=60

# Optional encryption key for RTMP settings; use a long random value
RTMP_ENCRYPTION_KEY=
