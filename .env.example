# Telegram / TMDB secrets
ADMIN_ID=
API_ID=
API_HASH=
BOT_TOKEN=
TMDB_API_KEY=

# Optional aliases supported by the loader
# TMDB_KEY=
# TMDB_TOKEN=

# Cinema/IPTV settings remain in config.py

# REST API / Video Player integration
API_HOST=127.0.0.1
API_PORT=8000
API_BASE_URL=http://127.0.0.1:8000
# Optional public URL used in stream/login responses when different from API_BASE_URL
# API_PUBLIC_BASE_URL=https://my-api.example.com
API_CORS_ORIGINS=*
API_SESSION_TTL=86400
API_LOGIN_TTL=300
API_STREAM_TTL=900
API_LOG_LEVEL=info
# Optional; bot.py auto-detects it from Telegram at startup.
# BOT_USERNAME=
