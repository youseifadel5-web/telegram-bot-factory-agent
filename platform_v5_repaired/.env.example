API_ID=
API_HASH=

# Dev only — enables mock test_source plugin
# ENABLE_TEST_SOURCE=1

# Timeouts
PLUGIN_TIMEOUT=12
HTTP_TIMEOUT=8
PLAYBACK_TIMEOUT=8
